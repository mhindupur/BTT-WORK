PORT=4000
DATABASE_URL=mysql://btt:btt@127.0.0.1:3307/btt_fleet
JWT_SECRET=change-me-to-long-random-string
PUBLIC_WEB_ORIGIN=http://localhost:5174
UPLOAD_DIR=./uploads

# WhatsApp for payment links: stub | interakt | meta
WHATSAPP_PROVIDER=stub

# Interakt — template must have one {{1}} body variable = payment URL
# INTERAKT_API_KEY=
# INTERAKT_TEMPLATE_NAME=payment_link
# INTERAKT_TEMPLATE_LANG=en
# INTERAKT_API_URL=https://api.interakt.ai/v1/public/message/
# INTERAKT_AUTH_MODE=basic
# Or set full header: INTERAKT_AUTHORIZATION=Basic xxx

# Meta WhatsApp Cloud API — template with one body parameter (text = URL)
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_TEMPLATE_NAME=
# META_WHATSAPP_TEMPLATE_LANG=en
# META_GRAPH_API_VERSION=v21.0

# Default admin (proposal: full system control)
ADMIN_EMAIL=admin@btt.fleet
ADMIN_PASSWORD=Admin@123

# Default supervisor / site manager (proposal: field operations)
DEMO_SM_EMAIL=supervisor@btt.fleet
DEMO_SM_PASSWORD=Supervisor@123
